#include <winver.h>

// Versionsinfo – Windows zeigt "Battery Status" u.a. im Task-Manager,
// in den Autostart-Einstellungen und bei "Andere Symbole auf der Taskleiste" an.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName",      "Dominik"
            VALUE "FileDescription",  "Battery Status"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Battery_Status"
            VALUE "OriginalFilename", "Battery_Status.exe"
            VALUE "ProductName",      "Battery Status"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
